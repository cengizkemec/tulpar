# Copy to .env for local development. Never commit a real secret.
# Use a CSPRNG to generate a value of at least 32 bytes.
TULPAR__AUTH__JWT_SECRET=replace-with-a-32-plus-byte-random-secret

# Development email defaults to a console link. Production requires SMTP.
# TULPAR__EMAIL__DRIVER=smtp
# TULPAR__EMAIL__SMTP_URL=smtp://user:password@127.0.0.1:1025
# TULPAR__EMAIL__FROM=Tulpar <noreply@example.com>
