# Copy to .env and fill every required value before starting the stack.
# Never commit the filled file.

TULPAR_DOMAIN=tulpar.example.com
TULPAR_ACME_EMAIL=admin@example.com
TULPAR_INSTANCE_NAME=Tulpar
TULPAR_CORS_ALLOWED_ORIGINS=["https://tulpar.example.com","http://tauri.localhost","https://tauri.localhost","tauri://localhost"]

TULPAR_POSTGRES_PASSWORD=replace-with-a-long-random-password
TULPAR_JWT_SECRET=replace-with-at-least-32-random-bytes
TULPAR_LIVEKIT_API_KEY=replace-with-a-livekit-key
TULPAR_LIVEKIT_SECRET=replace-with-a-long-random-livekit-secret
TULPAR_TURN_PASSWORD=replace-with-a-long-random-turn-secret

TULPAR_SMTP_URL=smtps://user:password@smtp.example.com:465
TULPAR_EMAIL_FROM=Tulpar <no-reply@example.com>

TULPAR_LOG_LEVEL=info
TULPAR_MAX_UPLOAD_BYTES=26214400
